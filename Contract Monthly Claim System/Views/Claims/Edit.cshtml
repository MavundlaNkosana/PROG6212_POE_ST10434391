@model Contract_Monthly_Claim_System.Models.Claim
@using Contract_Monthly_Claim_System.Helpers

@{
    ViewData["Title"] = "Manage Claim";
    var isDraft = Model.Status == ClaimStatus.Draft;
    var hourlyRate = (decimal)ViewBag.HourlyRate;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-0">Claim for @Model.Month/@Model.Year</h2>
            <p class="text-muted">Status: <span class="badge @ClaimStatusHelper.GetStatusBadgeClass(Model.Status)">@Model.Status</span></p>
        </div>
        <a asp-action="Index" class="btn btn-secondary">Back to My Claims</a>
    </div>

    <!-- Feedback Messages -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!isDraft)
    {
        <div class="alert alert-info">
            <i class="fas fa-lock mr-2"></i> This claim has been submitted and is locked for editing.
        </div>
    }

    <div class="row">
        <!-- Left Column: AUTOMATED Add New Item Form -->
        <div class="col-md-5">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-plus-circle mr-2"></i>Add Work Item</h5>
                </div>
                <div class="card-body">
                    <fieldset disabled="@(!isDraft)">
                        <form asp-action="AddItem" method="post" id="addItemForm">
                            <input type="hidden" name="claimId" value="@Model.ClaimId" />

                            <!-- Date Selection -->
                            <div class="form-group mb-3">
                                <label for="date" class="form-label fw-bold">Date of Work</label>
                                <input type="date" id="date" name="date" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                            </div>

                            <!-- Hours Input with Automation -->
                            <div class="form-group mb-3">
                                <label for="hours" class="form-label fw-bold">Hours Worked</label>
                                <input type="number" id="hours" name="hours" class="form-control form-control-lg" step="0.01" min="0.1" max="24" placeholder="0.00" required />
                                <div class="invalid-feedback" id="hoursError">
                                    Hours must be between 0.1 and 24.
                                </div>
                            </div>

                            <!-- Read-Only Rate Display -->
                            <div class="form-group mb-3">
                                <label class="form-label fw-bold">Hourly Rate (Fixed)</label>
                                <div class="input-group">
                                    <span class="input-group-text">R</span>
                                    <!-- We store the raw rate in a data attribute for JS to read easily -->
                                    <input type="text" class="form-control bg-light" id="rateDisplay" value="@hourlyRate.ToString("N2")" readonly data-rate="@hourlyRate" />
                                </div>
                            </div>

                            <!-- Auto-Calculated Total Preview -->
                            <div class="card bg-light mb-3 border-info">
                                <div class="card-body text-center p-2">
                                    <small class="text-muted text-uppercase">Calculated Payout</small>
                                    <h3 class="text-success mb-0" id="liveTotal">R 0.00</h3>
                                </div>
                            </div>

                            <div class="form-group mb-4">
                                <label for="activityDescription" class="form-label fw-bold">Description</label>
                                <textarea id="activityDescription" name="activityDescription" class="form-control" rows="2" placeholder="e.g., Lecture preparation" required></textarea>
                            </div>

                            <div class="d-grid">
                                <button type="submit" id="btnAddItem" class="btn btn-primary btn-lg" @(!isDraft ? "disabled" : "")>
                                    Add Item
                                </button>
                            </div>
                        </form>
                    </fieldset>
                </div>
            </div>
        </div>

        <!-- Right Column: Summary -->
        <div class="col-md-7">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Current Claim Summary</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Date</th>
                                    <th>Hours</th>
                                    <th>Amount</th>
                                    <th>Description</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items.OrderBy(i => i.Date))
                                {
                                    <tr>
                                        <td>@item.Date.ToString("dd MMM")</td>
                                        <td>@item.Hours.ToString("N2")</td>
                                        <td>@item.Amount.ToString("C")</td>
                                        <td>@item.ActivityDescription</td>
                                    </tr>
                                }
                                @if (!Model.Items.Any())
                                {
                                    <tr><td colspan="4" class="text-center text-muted py-3">No items added yet.</td></tr>
                                }
                            </tbody>
                            <tfoot class="table-light fw-bold">
                                <tr>
                                    <td colspan="2" class="text-end">Total:</td>
                                    <td class="text-success">@Model.TotalAmount.ToString("C")</td>
                                    <td>(@Model.TotalHours Hours)</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Documents Section -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Supporting Documents</h5>
                </div>
                <div class="card-body">
                    <fieldset disabled="@(!isDraft)">
                        <form asp-action="Upload" method="post" enctype="multipart/form-data" class="row g-2 align-items-center">
                            <input type="hidden" name="id" value="@Model.ClaimId" />
                            <div class="col-auto flex-grow-1">
                                <input type="file" name="file" class="form-control" required />
                            </div>
                            <div class="col-auto">
                                <button type="submit" class="btn btn-outline-secondary">Upload</button>
                            </div>
                        </form>
                    </fieldset>

                    @if (Model.Documents.Any())
                    {
                        <ul class="list-group mt-3">
                            @foreach (var doc in Model.Documents)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <span><i class="fas fa-file-alt me-2 text-primary"></i> @doc.FileName</span>
                                    <span class="badge bg-secondary">@((doc.FileSize / 1024.0).ToString("F1")) KB</span>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>

            <!-- Submit Button -->
            @if (isDraft)
            {
                <div class="d-grid">
                    <form asp-action="Submit" method="post" onsubmit="return confirm('Are you sure? Once submitted, you cannot edit this claim.');">
                        <input type="hidden" name="id" value="@Model.ClaimId" />
                        <button type="submit" class="btn btn-success btn-lg w-100 py-3 shadow">
                            <i class="fas fa-paper-plane mr-2"></i> Submit Final Claim
                        </button>
                    </form>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // 1. Get references to DOM elements
            const $hoursInput = $('#hours');
            const $rateInput = $('#rateDisplay');
            const $totalDisplay = $('#liveTotal');
            const $addBtn = $('#btnAddItem');
            const $hoursError = $('#hoursError');

            // Retrieve the numeric rate from the data attribute we set in HTML
            // Replace comma with dot for JS float parsing if locale uses comma
            const hourlyRate = parseFloat($rateInput.data('rate'));

            // 2. Define the Auto-Calculation Function
            function updateCalculation() {
                const hoursVal = parseFloat($hoursInput.val());

                // Validation: Check if input is a valid number
                if (isNaN(hoursVal) || hoursVal <= 0) {
                    $totalDisplay.text('R 0.00');
                    $addBtn.prop('disabled', true); // Disable button
                    if (hoursVal <= 0 && $hoursInput.val() !== "") {
                        $hoursInput.addClass('is-invalid'); // Show red border
                    } else {
                        $hoursInput.removeClass('is-invalid');
                    }
                    return;
                }

                // Validation: Check logical max hours (e.g., 24 hours in a day)
                if (hoursVal > 24) {
                    $hoursInput.addClass('is-invalid');
                    $addBtn.prop('disabled', true);
                    $totalDisplay.text('Invalid Hours');
                    return;
                }

                // Valid Input: Calculate and Display
                $hoursInput.removeClass('is-invalid');
                $addBtn.prop('disabled', false); // Enable button

                const total = hoursVal * hourlyRate;

                // Format currency for display (South African Rand)
                const formattedTotal = new Intl.NumberFormat('en-ZA', {
                    style: 'currency',
                    currency: 'ZAR'
                }).format(total);

                $totalDisplay.text(formattedTotal);
            }

            // 3. Attach Event Listener
            // Run calculation every time the user types or changes the number
            $hoursInput.on('input keyup change', updateCalculation);
        });
    </script>
}