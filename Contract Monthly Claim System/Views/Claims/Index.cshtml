@using Contract_Monthly_Claim_System.Helpers
@using System.Collections.Concurrent
@using Contract_Monthly_Claim_System.Models
@model IEnumerable<Contract_Monthly_Claim_System.Models.Claim>

@{
    ViewData["Title"] = "My Claims";
    // Safely cast the Viewbag data
    var lecturers = ViewBag.Lecturers as ConcurrentDictionary<Guid, Lecturer>;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">My Claims Dashboard</h2>
        <a asp-action="Create" class="btn btn-primary">Create New Claim</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-hover">
                <thead class="thead-light">
                    <tr>
                        <th>Claim Period</th>
                        <th>Lecturer</th>
                        <th>Submitted On</th>
                        <th class="text-right">Total Amount</th>
                        <th class="text-center">Status</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var claim in Model)
                        {
                            <tr>
                                <td>@claim.Month/@claim.Year</td>
                                <td>
                                    @if (lecturers != null && lecturers.TryGetValue(claim.LecturerId, out var l))
                                    {
                                        @l.FullName
                                    }
                                    else
                                    {
                                        <span>Unknown</span>
                                    }
                                </td>
                                <td>@(claim.SubmittedAt.HasValue? claim.SubmittedAt.Value.ToShortDateString() : "-")</td>
                                <td class="text-right font-weight-bold">@claim.TotalAmount.ToString("C")</td>
                                <td class="text-center">
                                    <span class="badge @ClaimStatusHelper.GetStatusBadgeClass(claim.Status)">
                                        @claim.Status
                                    </span>
                                </td>
                                <td class="text-center">
                                    <a asp-action="Edit" asp-route-id="@claim.ClaimId" class="btn btn-sm btn-outline-primary">
                                        View / Edit
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center">No claims found. Click "Create New Claim" to start.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>