@{
    ViewData["Title"] = "HR Dashboard";
}

<div class="container mt-5">
    <h2 class="mb-4 text-center">Human Resources Dashboard</h2>
    <div class="row justify-content-center">
        <!-- Card 1: Lecturer Management -->
        <div class="col-md-5 mb-4">
            <div class="card h-100 shadow-sm border-primary">
                <div class="card-body text-center p-5">
                    <i class="fas fa-users-cog fa-3x text-primary mb-3"></i>
                    <h3 class="card-title">Manage Lecturers</h3>
                    <p class="card-text text-muted">Update contact details, staff numbers, and hourly rates.</p>
                    <a asp-action="ManageLecturers" class="btn btn-primary btn-lg w-100 mt-3">Go to Directory</a>
                </div>
            </div>
        </div>

        <!-- Card 2: Finance & Reporting -->
        <div class="col-md-5 mb-4">
            <div class="card h-100 shadow-sm border-success">
                <div class="card-body text-center p-5">
                    <i class="fas fa-file-invoice-dollar fa-3x text-success mb-3"></i>
                    <h3 class="card-title">Payment Reports</h3>
                    <p class="card-text text-muted">View approved claims and generate invoices for payment.</p>
                    <a asp-action="PaymentReport" class="btn btn-success btn-lg w-100 mt-3">View Reports</a>
                </div>
            </div>
        </div>
    </div>
</div>