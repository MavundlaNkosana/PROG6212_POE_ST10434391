@{
    ViewData["Title"] = "Welcome";
}

<div class="text-center mt-5">
    <h1 class="display-4">Contract Claim System</h1>
    <p class="lead text-muted">Welcome to the monthly claim portal. Please select your role below.</p>
    <hr class="my-4">

    <div class="row justify-content-center mt-5">
        <!-- Lecturer Button -->
        <div class="col-md-4 mb-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column justify-content-center align-items-center p-5">
                    <h3 class="mb-4">Lecturers</h3>
                    <p class="text-muted mb-4">Submit claims and track status.</p>
                    <a asp-controller="Claims" asp-action="Index" class="btn btn-primary btn-lg px-5">
                        My Claims
                    </a>
                </div>
            </div>
        </div>

        <!-- Coordinator Button -->
        <div class="col-md-4 mb-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column justify-content-center align-items-center p-5">
                    <h3 class="mb-4">Coordinators</h3>
                    <p class="text-muted mb-4">Verify and approve claims.</p>
                    <a asp-controller="Coordinator" asp-action="Index" class="btn btn-outline-dark btn-lg px-5">
                        Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>