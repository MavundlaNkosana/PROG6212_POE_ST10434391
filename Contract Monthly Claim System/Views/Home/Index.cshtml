@{
    ViewData["Title"] = "Welcome";
}

<div class="text-center mt-5">
    <h1 class="display-4">Contract Claim System</h1>
    <p class="lead text-muted">Welcome to the monthly claim portal. Select your role to begin.</p>
    <hr class="my-4">

    <div class="row justify-content-center mt-4">
        <!-- Lecturer -->
        <div class="col-md-4 mb-3">
            <div class="card h-100 shadow-sm hover-effect">
                <div class="card-body p-5">
                    <h3 class="mb-3">Lecturer</h3>
                    <p class="text-muted">Submit claims and upload documents.</p>
                    <a asp-controller="Claims" asp-action="Index" class="btn btn-primary btn-block w-100">My Claims</a>
                </div>
            </div>
        </div>

        <!-- Coordinator -->
        <div class="col-md-4 mb-3">
            <div class="card h-100 shadow-sm hover-effect">
                <div class="card-body p-5">
                    <h3 class="mb-3">Approver</h3>
                    <p class="text-muted">Coordinators & Managers verify claims.</p>
                    <a asp-controller="Coordinator" asp-action="Index" class="btn btn-outline-dark btn-block w-100">Review Claims</a>
                </div>
            </div>
        </div>

        <!-- HR Role (New) -->
        <div class="col-md-4 mb-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column justify-content-center align-items-center p-5">
                    <h3 class="mb-4">HR Admin</h3>
                    <p class="text-muted mb-4">Manage staff and payroll.</p>
                    <a asp-controller="HR" asp-action="Index" class="btn btn-outline-success btn-lg px-5">
                        HR Portal
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>