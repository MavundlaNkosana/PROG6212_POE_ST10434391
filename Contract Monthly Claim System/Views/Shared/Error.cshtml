@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="text-center mt-5">
    <h1 class="display-1 text-danger">Oops!</h1>
    <h2 class="mt-4">Something went wrong.</h2>
    <p class="lead text-muted mt-3">
        We're sorry, but an unexpected error occurred while processing your request.
    </p>
    <p>
        Please try again later, or contact support if the problem persists.
    </p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-4">Go to Homepage</a>

    @* Only show the technical details if in the Development environment *@
    @if (Model.ShowRequestId)
    {
        <div class="alert alert-danger mt-5">
            <p>
                <strong>Request ID:</strong> <code>@Model.RequestId</code>
            </p>
            <p>
                This information is valuable for debugging. Please include it in any support requests.
            </p>
        </div>
    }
</div>
